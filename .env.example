# ==============================================================================
# MISSION CONTROL - GLOBAL CONFIGURATION & CREDENTIALS (.env)
# ==============================================================================
# File ini menyimpan API Keys dan default endpoints. Salin ke .env sebelum menjalankan.
# Aturan:
# 1. API Keys & Secrets selalu ditaruh di sini (.env), BUKAN di mission.yaml.
# 2. mission.yaml hanya menentukan nama model dan provider.
# ==============================================================================

# --- OPSI 1: OpenAI Langsung ---
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1

# --- OPSI 2: Ollama (Lokal / Self-Hosted di PC / Laptop) ---
OLLAMA_API_BASE=http://localhost:11434

# --- OPSI 3: Cloud Providers Lainnya ---
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# --- OPSI 4: Self-Hosted OmniRoute / 9router Gateway (Local SBC) ---
# Jika menjalankan di server SBC lokal (port 20128):
# 9ROUTER_API_BASE=http://localhost:20128/v1
# 9ROUTER_API_KEY=sk-7eb...72e6

# --- TOOL CREDENTIALS ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
NOTION_API_TOKEN=your_notion_token_here
MARKET_DATA_SCRIPT_PATH=/root/rndz-market-data/ingest.py
